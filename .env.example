# PostgreSQL über Unix-Socket (Uberspace: host=/home/<user>/tmp o. ä.)
DATABASE_URL="postgres://<user>@localhost/stellenwert?host=/path/to/socket-dir"
# 32 Byte hex, z. B.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=""
# Öffentliche Adresse (Pflicht in Produktion, sonst lehnt SvelteKit Formulare als Cross-Site ab)
ORIGIN="https://stellenwert.example.de"
# Hinter dem Uberspace-Proxy: echte Client-IP für das Login-Rate-Limit (sonst teilen sich alle eine IP)
ADDRESS_HEADER="X-Forwarded-For"
XFF_DEPTH="1"
# Adresse, auf der der Node-Prozess lauscht (Uberspace: 0.0.0.0 und der Port aus `uberspace web backend set`)
HOST="0.0.0.0"
PORT="3000"
